#!/bin/sh
# After a commit, bring memory in step with what was committed, in the background,
# so the commit is not held up. Turn on with: git config core.hooksPath tools/hooks
#
# It syncs only into the space this folder is already bound to (where it was first
# seeded or synced), never into whichever space an agent happens to be using, and it
# only runs a command made for this, which never starts an agent session.
# Set NA8VE_SYNC_BRANCH (for example to main) to sync from that branch only, so a
# space a team shares follows committed code on one branch, not every experiment.
if [ -n "$NA8VE_SYNC_BRANCH" ] && [ "$(git rev-parse --abbrev-ref HEAD)" != "$NA8VE_SYNC_BRANCH" ]; then
	exit 0
fi
if command -v na8ve-code-sync > /dev/null 2>&1; then
	set -- na8ve-code-sync
else
	exit 0
fi
log="$(git rev-parse --git-dir)/na8ve-code-sync.log"
("$@" > "$log" 2>&1 < /dev/null &)
echo "post-commit: syncing memory with this commit in the background ($log)"
